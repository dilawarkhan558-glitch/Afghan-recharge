<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>AFGHAN TOPUP</title>
<style>
*{box-sizing:border-box;font-family:system-ui}body{margin:0;background:#0A0A0A;color:#fff;padding-bottom:85px}
.flag{height:8px;display:flex;position:sticky;top:0;z-index:99}.flag div{flex:1}.b{background:#000}.r{background:#D32011}.g{background:#007A36}
.top{display:flex;justify-content:space-between;align-items:center;padding:16px}.logo{font-size:24px;font-weight:900}
.lang-btn{background:#1E1E1E;border:1px solid #333;border-radius:20px;padding:7px 14px;font-size:13px;cursor:pointer}
.live{display:flex;justify-content:space-between;background:#121212;padding:8px 16px;font-size:12px;color:#4ade80;border:1px solid #1a1a1a}
.page{display:none}.page.active{display:block}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:14px}
.op{padding:18px;border-radius:16px;text-align:center;font-weight:900;cursor:pointer;border:2px solid transparent}.op.sel{border-color:#fff;transform:scale(.97)}
.ro{background:#E53935}.aw{background:#3B82F6}.et{background:#6fbf8a}.mt{background:#FCD86F;color:#000}.sa{background:#2E6B4A;grid-column:span 2}
.amtgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:0 14px}
.amt{background:#1E1E1E;border:1px solid #333;border-radius:14px;padding:16px;text-align:center;font-weight:800;cursor:pointer}.amt.sel{border-color:#fff;background:#2A2A2A}.amt small{display:block;color:#6fbf8a;font-size:11px;margin-top:4px}
.phone{display:flex;background:#1E1E1E;border:1px solid #333;border-radius:14px;margin:14px;overflow:hidden}.pref{padding:14px;background:#2A2A2A;font-weight:800;border-right:1px solid #333}.phone input{flex:1;background:transparent;border:none;padding:14px;color:#fff;outline:none;font-size:15px}
.btn{margin:14px;background:#fff;color:#000;padding:16px;border-radius:16px;text-align:center;font-weight:900;font-size:17px;cursor:pointer}
.card{background:#151515;border:1px solid #222;border-radius:14px;padding:14px;margin:10px 14px}
.support{background:#111;border:1px solid #333;border-radius:14px;padding:14px;margin:14px;display:flex;justify-content:space-between;align-items:center}
.bottom{position:fixed;bottom:0;left:0;right:0;background:#0f0f0f;border-top:1px solid #222;display:flex;justify-content:space-around;padding:8px 0}
.bottom div{text-align:center;font-size:10px;color:#777;cursor:pointer;padding:5px 12px}.bottom div.active{color:#fff}
</style></head><body>
<div class="flag"><div class="b"></div><div class="r"></div><div class="g"></div></div>
<div class="top"><div class="logo" id="logo">AFGHAN TOPUP 🇦🇫</div><div class="lang-btn" onclick="toggleLang()">🌐 <span id="ltxt">EN</span></div></div>
<div class="live"><span id="live1">● LIVE RATE - EURO</span><span id="live2">1 EUR = 88.20 AFN</span></div>

<!-- HOME -->
<div id="home" class="page active">
<div class="grid2">
<div class="op ro" onclick="setOp(this,'Roshan')">ROSHAN</div>
<div class="op aw" onclick="setOp(this,'AWCC')">AWCC</div>
<div class="op et" onclick="setOp(this,'Etisalat')">ETISALAT</div>
<div class="op mt" onclick="setOp(this,'MTN')">MTN</div>
<div class="op sa" onclick="setOp(this,'Salaam')">SALAAM</div>
</div>
<div class="amtgrid">
<div class="amt" onclick="setAmt(this,'100')">100 AFN <small>€1.13</small></div>
<div class="amt" onclick="setAmt(this,'200')">200 AFN <small>€2.26</small></div>
<div class="amt" onclick="setAmt(this,'500')">500 AFN <small>€5.66</small></div>
<div class="amt" onclick="setAmt(this,'1000')">1000 AFN <small>€11.33</small></div>
</div>
<div class="phone"><div class="pref">🇦🇫 +93</div><input id="ph" placeholder="700123456"></div>
<div class="btn" onclick="goBank()" id="rbtn">RECHARGE NOW</div>
<div style="text-align:center;color:#555;font-size:11px" id="foot">Secure Payment • Instant Topup • 24/7 Support</div>
</div>

<!-- BANK -->
<div id="bank" class="page">
<div style="padding:18px;font-size:20px;font-weight:800"
