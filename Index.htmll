<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Afghan Recharge</title>
<style>
*{box-sizing:border-box;font-family:system-ui,sans-serif}
body{margin:0;background:#f6f7f9;color:#111;padding-bottom:80px}
.flag{height:6px;display:flex} .flag div{flex:1} .b{background:#000}.r{background:#D32011}.g{background:#007A36}
.header{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;background:#fff;border-bottom:1px solid #eee;position:sticky;top:0;z-index:10}
.ssl{background:#e8f5e9;color:#2e7d32;padding:8px;text-align:center;font-size:12px;font-weight:600}
h2{padding:20px 16px 0;margin:0;font-size:22px} p.sub{padding:4px 16px 10px;color:#666;font-size:14px;margin:0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:16px}
.card{background:#fff;border-radius:16px;padding:16px;text-align:center;border:1px solid #eee;box-shadow:0 2px 8px rgba(0,0,0,0.04);cursor:pointer}
.card b{display:block;margin-top:8px} .card span{font-size:12px;color:#666}
.card .icon{border-radius:12px;padding:12px;font-weight:900;font-size:20px}
.r{background:#fde8e8;color:#c62828}.e{background:#eef6d8;color:#5a7d00}.a{background:#e3eefc;color:#1e4b8c}.s{background:#dff0e6;color:#0a5c36}.m{background:#fff3a3;color:#8a6d00}
.page{display:none}.page.active{display:block}
.phone-box{display:flex;align-items:center;background:#fff;border:1px solid #ddd;border-radius:12px;overflow:hidden;margin:16px}
.prefix{background:#f5f5f5;padding:14px;font-weight:bold;border-right:1px solid #ddd}
.phone-box input{flex:1;border:none;padding:14px;font-size:16px;outline:none}
.amt-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:0 16px}
.amt{background:#fff;border:1px solid #ddd;border-radius:10px;padding:14px;text-align:center;font-weight:600;cursor:pointer}
.amt.sel{border-color:#007A36;background:#e8f5e9}
.btn-green{margin:16px;background:#0A5C36;color:#fff;padding:16px;text-align:center;border-radius:12px;font-weight:900;cursor:pointer}
.bottom{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #eee;display:flex;justify-content:space-around;padding:8px 0}
.bottom div{text-align:center;font-size:11px;color:#888;cursor:pointer;padding:6px 16px}
.bottom div.active{color:#D32011}
.list{background:#fff;margin:10px 16px;border-radius:12px;padding:14px;border:1px solid #eee}
</style></head><body>
<div class="flag"><div class="b"></div><div class="r"></div><div class="g"></div></div>
<div class="header"><b>🇦🇫 Afghan Recharge</b><div style="border:1px solid #ddd;border-radius:20px;padding:6px 12px">🌐 EN</div></div>
<div class="ssl">🛡️ 256-Bit SSL Encrypted • Instant Top-Up Delivery</div>
<div id="home" class="page active">
<h2>Select Your Network</h2><p class="sub">Choose your telecom operator to get started</p>
<div class="grid">
<div class="card" onclick="goRecharge('Roshan')"><div class="icon r">R Roshan</div><b>Roshan</b><span>Roshan (Telecom Development Company Afghanistan)</span></div>
<div class="card" onclick="goRecharge('Etisalat')"><div class="icon e">AN etisalat</div><b>Etisalat</b><span>Etisalat Afghanistan</span></div>
<div class="card" onclick="goRecharge('AWCC')"><div class="icon a">📶 AWCC</div><b>AWCC</b><span>Afghan Wireless Communication Company</span></div>
<div class="card" onclick="goRecharge('Salaam')"><div class="icon s">S Salaam</div><b>Salaam Telecom</b><span>Salaam Telecom (ATRA)</span></div>
<div class="card" onclick="goRecharge('MTN')"><div class="icon m">MTN</div><b>MTN Afghanistan</b><span>MTN Afghanistan (Atoma)</span></div>
</div></div>
<div id="recharge" class="page"><h2 id="opName">Recharge</h2><div class="phone-box"><div class="prefix">🇦🇫 +93</div><input id="phone" type="tel" placeholder="771 921 149"></div><div class="amt-grid"><div class="amt" onclick="selAmt(this,'50 AFN')">50 AFN</div><div class="amt" onclick="selAmt(this,'100 AFN')">100 AFN</div><div class="amt" onclick="selAmt(this,'200 AFN')">200 AFN</div><div class="amt" onclick="selAmt(this,'500 AFN')">500 AFN</div></div><div class="btn-green" onclick="doRecharge()">RECHARGE NOW</div><div class="btn-green" style="background:#eee;color:#333" onclick="showPage('home')">Back to Home</div></div>
<div id="history" class="page"><h2>History</h2><div class="list">No recharges yet</div></div>
<div id="alerts" class="page"><h2>Alerts</h2><div class="list">🔔 All systems operational</div></div>
<div id="settings" class="page"><h2>Settings</h2><div class="list" onclick="window.open('tel:+93771921149')">📞 Support Number: +93 771 921 149</div><div class="list" onclick="showPage('home')">🏠 Home</div><div class="list">ℹ️ About - Afghan Topup v2.0</div><div class="list">📧 support@afghantopup.com</div></div>
<div class="bottom"><div class="active" id="b-home" onclick="showPage('home')">🏠<br>Home</div><div id="b-history" onclick="showPage('history')">🕒<br>History</div><div id="b-alerts" onclick="showPage('alerts')">🔔<br>Alerts</div><div id="b-settings" onclick="showPage('settings')">⚙️<br>Settings</div></div>
<script>
let selOp='', selAmount='';
function showPage(p){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));document.getElementById(p).classList.add('active');document.querySelectorAll('.bottom div').forEach(x=>x.classList.remove('active'));document.getElementById('b-'+p).classList.add('active');}
function goRecharge(op){selOp=op;document.getElementById('opName').innerText=op+' Recharge';showPage('recharge');}
function selAmt(el,val){document.querySelectorAll('.amt').forEach(x=>x.classList.remove('sel'));el.classList.add('sel');selAmount=val;}
function doRecharge(){let num=document.getElementById('phone').value.trim();if(!num){alert('Number likho');return}if(!selAmount){alert('Amount select karo');return}if(num.startsWith('0')) num=num.substring(1);let full='+93'+num;alert(selOp+' '+selAmount+' to '+full+' Success!');}
</script>
</body></html>
